# ============================================================
# WayHome Backend — Environment Variables
# ============================================================
# Copy this file to a real secrets manager or CI/CD env.
# NEVER commit actual values to git.

# --- MySQL -------------------------------------------------------
DB_URL=jdbc:mysql://your-db-host:3306/wayhome?useSSL=true&serverTimezone=UTC
DB_USERNAME=wayhome_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# --- JWT ---------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_minimum_64_character_secret_here_use_openssl_rand_hex_64

# --- CORS --------------------------------------------------------
FRONTEND_URL=https://your-frontend-domain.com

# --- Feature Flags -----------------------------------------------
# Set to false in production to avoid re-seeding demo data
SEED_DEMO_DATA=false

# --- Debug -------------------------------------------------------
# Set to false in production
SHOW_SQL=false
